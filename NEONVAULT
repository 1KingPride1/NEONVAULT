<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NEONVAULT — Магазин битов</title>
  <style>
    :root {
      --bg: #08090d;
      --surface: #11131b;
      --surface-hover: #181b26;
      --border: #232738;
      --text: #f3f4f8;
      --muted: #8f96ad;
      --accent: #00f0ff;
      --accent-2: #8b5cf6;
      --danger: #ff4d6d;
      --radius: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
      background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.14), transparent 40%),
                  radial-gradient(circle at bottom left, rgba(0, 240, 255, 0.1), transparent 40%),
                  var(--bg);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(8, 9, 13, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 70px;
    }

    .logo {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo-badge {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 14px var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 24px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .cart-btn {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px 16px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: 0.2s;
    }

    .cart-btn:hover {
      border-color: var(--accent);
      box-shadow: 0 0 16px rgba(0, 240, 255, 0.15);
    }

    .cart-count {
      background: var(--accent);
      color: #05070a;
      font-size: 0.8rem;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 999px;
    }

    /* Hero */
    .hero {
      padding: 72px 0 48px;
      text-align: center;
    }

    .hero-tag {
      display: inline-block;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(0, 240, 255, 0.1);
      border: 1px solid rgba(0, 240, 255, 0.3);
      color: var(--accent);
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 16px;
    }

    .hero h1 span {
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--muted);
      max-width: 620px;
      margin: 0 auto 28px;
      font-size: 1.05rem;
    }

    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent), #00b8d4);
      color: #05070a;
      border: none;
      padding: 13px 24px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s;
    }

    .btn-primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(0, 240, 255, 0.3);
    }

    .btn-secondary {
      background:


var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 13px 24px;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
      transition: 0.2s;
    }

    .btn-secondary:hover {
      border-color: var(--accent-2);
    }

    /* Controls / Filters */
    .catalog-section {
      padding: 30px 0 70px;
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .genres {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .genre-pill {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 8px 14px;
      border-radius: 999px;
      font-size: 0.88rem;
      cursor: pointer;
      transition: 0.2s;
    }

    .genre-pill.active,
    .genre-pill:hover {
      color: var(--text);
      border-color: var(--accent);
      background: rgba(0, 240, 255, 0.08);
    }

    .search-input {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 10px;
      min-width: 240px;
      outline: none;
    }

    .search-input:focus {
      border-color: var(--accent);
    }

    /* Beat List */
    .beat-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .beat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
      display: grid;
      grid-template-columns: auto 1fr auto auto;
      align-items: center;
      gap: 18px;
      transition: 0.2s;
    }

    .beat-card:hover {
      background: var(--surface-hover);
      border-color: #323850;
    }

    .beat-card.playing {
      border-color: var(--accent);
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.12);
    }

    .play-btn {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: none;
      background: rgba(0, 240, 255, 0.14);
      color: var(--accent);
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      display: grid;
      place-items: center;
      transition: 0.2s;
    }

    .beat-card.playing .play-btn,
    .play-btn:hover {
      background: var(--accent);
      color: #05070a;
    }

    .beat-info h3 {
      font-size: 1.05rem;
      margin-bottom: 4px;
    }

    .beat-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      font-size: 0.84rem;
      color: var(--muted);
    }

    .tag {
      background: rgba(255, 255, 255, 0.05);
      padding: 2px 8px;
      border-radius: 6px;
    }

    .license-select {
      background: #0c0e14;
      border: 1px solid var(--border);
      color: var(--text);
      padding: 9px 12px;
      border-radius: 9px;
      font-size: 0.88rem;
      cursor: pointer;
    }

    .buy-btn {
      background: var(--accent-2);
      color: #fff;
      border: none;
      padding: 10px 16px;
      border-radius: 9px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: 0.2s;
    }

    .buy-btn:hover {
      filter: brightness(1.12);
    }

    /* Licenses Grid */
    .section-title {
      font-size: 1.7rem;
      margin-bottom: 8px;
    }

    .section-sub {
      color: var(--muted);
      margin-bottom: 28px;
    }

    .licenses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin-bottom: 70px;
    }

    .license-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .license-card.featured {
      border-color: var(--accent);
      background: linear-gradient(180deg, rgba(0, 240, 255, 0.07), var(--surface));
    }


.license-card h3 {
      font-size: 1.15rem;
      margin-bottom: 6px;
    }

    .license-price {
      font-size: 1.6rem;
      font-weight: 800;
      color: var(--accent);
      margin-bottom: 14px;
    }

    .license-card ul {
      list-style: none;
      color: var(--muted);
      font-size: 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* Custom Beat Form */
    .custom-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
      margin-bottom: 70px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-bottom: 14px;
    }

    .input, textarea {
      width: 100%;
      background: #0c0e14;
      border: 1px solid var(--border);
      color: var(--text);
      padding: 12px 14px;
      border-radius: 10px;
      font-family: inherit;
      font-size: 0.95rem;
    }

    textarea {
      min-height: 100px;
      resize: vertical;
      margin-bottom: 14px;
    }

    /* Drawer Cart */
    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      display: none;
      z-index: 50;
    }

    .drawer-backdrop.open {
      display: block;
    }

    .drawer {
      position: fixed;
      top: 0;
      right: -400px;
      width: 100%;
      max-width: 380px;
      height: 100vh;
      background: #0e1017;
      border-left: 1px solid var(--border);
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 60;
      transition: right 0.25s ease;
    }

    .drawer.open {
      right: 0;
    }

    .drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
    }

    .close-btn {
      background: none;
      border: none;
      color: var(--muted);
      font-size: 1.4rem;
      cursor: pointer;
    }

    .cart-items {
      flex: 1;
      overflow-y: auto;
      padding: 16px 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .cart-item {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .remove-btn {
      background: none;
      border: none;
      color: var(--danger);
      cursor: pointer;
      font-size: 0.85rem;
    }

    .drawer-footer {
      border-top: 1px solid var(--border);
      padding-top: 16px;
    }

    .total-row {
      display: flex;
      justify-content: space-between;
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 14px;
    }

    .toast {
      position: fixed;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--surface);
      border: 1px solid var(--accent);
      color: var(--text);
      padding: 12px 20px;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      display: none;
      z-index: 80;
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 28px 0;
      text-align: center;
      color: var(--muted);
      font-size: 0.9rem;
    }

    max-width: 760px {
      .beat-card {
        grid-template-columns: auto 1fr;
      }
      .license-select, .buy-btn {
        grid-column: 1 / -1;
        width: 100%;
      }
      .nav-links {
        display: none;
      }
    }
  </style>
</head>
