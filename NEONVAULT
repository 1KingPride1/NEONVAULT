  <script>
    // Каталог битов (замени audioUrl на пути к твоим MP3-файлам, например "./beats/track1.mp3")
    const BEATS = [
      {
        id: "b1",
        title: "Midnight Static",
        genre: "Trap",
        bpm: 142,
        key: "F minor",
        tags: ["dark", "808", "night"],
        audioUrl: "",
        freq: 110,
        licenses: [
          { id: "mp3", name: "MP3 Lease", price: 1500 },
          { id: "wav", name: "WAV Lease", price: 3500 },
          { id: "stems", name: "Trackout / Stems", price: 8000 },
          { id: "excl", name: "Exclusive Rights", price: 25000 }
        ]
      },
      {
        id: "b2",
        title: "Cold London",
        genre: "Drill",
        bpm: 144,
        key: "C# minor",
        tags: ["uk drill", "sliding 808", "aggressive"],
        audioUrl: "",
        freq: 130.81,
        licenses: [
          { id: "mp3", name: "MP3 Lease", price: 1500 },
          { id: "wav", name: "WAV Lease", price: 3500 },
          { id: "stems", name: "Trackout / Stems", price: 8000 },
          { id: "excl", name: "Exclusive Rights", price: 25000 }
        ]
      },
      {
        id: "b3",
        title: "Cyber Highway",
        genre: "Synthwave",
        bpm: 118,
        key: "A minor",
        tags: ["retro", "analog", "neon"],
        audioUrl: "",
        freq: 146.83,
        licenses: [
          { id: "mp3", name: "MP3 Lease", price: 1500 },
          { id: "wav", name: "WAV Lease", price: 3500 },
          { id: "stems", name: "Trackout / Stems", price: 8000 },
          { id: "excl", name: "Exclusive Rights", price: 25000 }
        ]
      },
      {
        id: "b4",
        title: "Rainy Tape",
        genre: "Lo-Fi",
        bpm: 84,
        key: "D major",
        tags: ["chill", "vinyl", "rhodes"],
        audioUrl: "",
        freq: 164.81,
        licenses: [
          { id: "mp3", name: "MP3 Lease", price: 1200 },
          { id: "wav", name: "WAV Lease", price: 2900 },
          { id: "stems", name: "Trackout / Stems", price: 6500 },
          { id: "excl", name: "Exclusive Rights", price: 20000 }
        ]
      }
    ];

    let selectedGenre = "All";
    let searchQuery = "";
    let cart = [];
    let activeBeatId = null;
    let htmlAudio = null;
    let audioCtx = null;
    let synthInterval = null;

    const beatListEl = document.getElementById("beatList");
    const cartCountEl = document.getElementById("cartCount");
    const cartItemsEl = document.getElementById("cartItems");
    const cartTotalEl = document.getElementById("cartTotal");
    const toastEl = document.getElementById("toast");

    function showToast(msg) {
      toastEl.textContent = msg;
      toastEl.style.display = "block";
      clearTimeout(toastEl._timer);
      toastEl._timer = setTimeout(() => {
        toastEl.style.display = "none";
      }, 2800);
    }

    function stopAllAudio() {
      if (htmlAudio) {
        htmlAudio.pause();
        htmlAudio.currentTime = 0;
        htmlAudio = null;
      }
      if (synthInterval) {
        clearInterval(synthInterval);
        synthInterval = null;
      }
      activeBeatId = null;
    }

    // Демо-синтезатор, если audioUrl ещё не заполнен реальным MP3
    function startDemoSynth(baseFreq, bpm) {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if


(audioCtx.state === "suspended") {
        audioCtx.resume();
      }
      const stepMs = (60 / bpm) * 1000 / 2;
      const pattern = [1, 1, 1.5, 1, 1.25, 1, 1.5, 1.875];
      let step = 0;

      const triggerNote = () => {
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = "sawtooth";
        osc.frequency.value = baseFreq * pattern[step % pattern.length];

        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.22);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.23);
        step++;
      };

      triggerNote();
      synthInterval = setInterval(triggerNote, stepMs);
    }

    function togglePlay(beatId) {
      const wasPlaying = activeBeatId === beatId;
      stopAllAudio();

      if (!wasPlaying) {
        const beat = BEATS.find(b => b.id === beatId);
        if (!beat) return;
        activeBeatId = beatId;

        if (beat.audioUrl) {
          htmlAudio = new Audio(beat.audioUrl);
          htmlAudio.play().catch(() => {
            showToast("Не удалось загрузить аудиофайл. Проверь путь audioUrl.");
            stopAllAudio();
            renderBeats();
          });
          htmlAudio.onended = () => {
            stopAllAudio();
            renderBeats();
          };
        } else {
          startDemoSynth(beat.freq || 110, beat.bpm);
        }
      }
      renderBeats();
    }

    function renderBeats() {
      const filtered = BEATS.filter(beat => {
        const matchesGenre = selectedGenre === "All" || beat.genre === selectedGenre;
        const q = searchQuery.toLowerCase();
        const matchesSearch =
          beat.title.toLowerCase().includes(q) ||
          beat.key.toLowerCase().includes(q) ||
          String(beat.bpm).includes(q) ||
          beat.tags.some(t => t.toLowerCase().includes(q));
        return matchesGenre && matchesSearch;
      });

      if (!filtered.length) {
        beatListEl.innerHTML = `<p style="color: var(--muted); padding: 20px 0;">По твоему запросу биты не найдены.</p>`;
        return;
      }

      beatListEl.innerHTML = filtered.map(beat => {
        const isPlaying = activeBeatId === beat.id;
        const options = beat.licenses
          .map((lic, idx) => `<option value="${idx}">${lic.name} — ${lic.price.toLocaleString("ru-RU")} ₽</option>`)
          .join("");

        return `
          <article class="beat-card ${isPlaying ? "playing" : ""}">
            <button class="play-btn" onclick="togglePlay('${beat.id}')" title="Слушать">
              ${isPlaying ? "❚❚" : "▶"}
            </button>
            <div class="beat-info">
              <h3>${beat.title}</h3>
              <div class="beat-meta">
                <span>${beat.genre}</span>
                <span>• ${beat.bpm} BPM</span>
                <span>• ${beat.key}</span>
                ${beat.tags.map(t => `<span class="tag">#${t}</span>`).join("")}
              </div>
            </div>
            <select class="license-select" id="lic-${beat.id}">
              ${options}
            </select>
            <button class="buy-btn" onclick="addToCart('${beat.id}')">В корзину</button>
          </article>
        `;
      }).join("");
    }

    function addToCart(beatId) {
      const beat = BEATS.find(b => b.id === beatId);
      const selectEl = document.getElementById(`lic-${beatId}`);
      const license = beat.licenses[Number(selectEl.value)];

      const existing = cart.find(item => item.beatId === beatId && item.licenseId === license.id);
      if (existing) {
        showToast("Эта лицензия уже добавлена в корзину");
        return;
      }

      cart.push({
        beatId: beat.id,
        title: beat.title,
        licenseId: license.id,
        licenseName: license.name,
        price: license.price
      });
      updateCartUI();
      showToast(
MAXIMA
mxm.id


`«${beat.title}» (${license.name}) добавлен в корзину`);
    }

    function removeFromCart(index) {
      cart.splice(index, 1);
      updateCartUI();
    }

    function updateCartUI() {
      cartCountEl.textContent = cart.length;
      const total = cart.reduce((sum, item) => sum + item.price, 0);
      cartTotalEl.textContent = `${total.toLocaleString("ru-RU")} ₽`;

      if (!cart.length) {
        cartItemsEl.innerHTML = `<p style="color: var(--muted);">Корзина пока пуста.</p>`;
        return;
      }

      cartItemsEl.innerHTML = cart.map((item, idx) => `
        <div class="cart-item">
          <div>
            <strong>${item.title}</strong>
            <div style="font-size: 0.85rem; color: var(--muted);">${item.licenseName} • ${item.price.toLocaleString("ru-RU")} ₽</div>
          </div>
          <button class="remove-btn" onclick="removeFromCart(${idx})">Удалить</button>
        </div>
      `).join("");
    }

    // Фильтры и поиск
    document.getElementById("genreFilters").addEventListener("click", (e) => {
      if (!e.target.classList.contains("genre-pill")) return;
      document.querySelectorAll(".genre-pill").forEach(btn => btn.classList.remove("active"));
      e.target.classList.add("active");
      selectedGenre = e.target.dataset.genre;
      renderBeats();
    });

    document.getElementById("searchInput").addEventListener("input", (e) => {
      searchQuery = e.target.value.trim();
      renderBeats();
    });

    // Корзина
    const drawer = document.getElementById("cartDrawer");
    const backdrop = document.getElementById("drawerBackdrop");

    function openCart() {
      drawer.classList.add("open");
      backdrop.classList.add("open");
    }

    function closeCart() {
      drawer.classList.remove("open");
      backdrop.classList.remove("open");
    }

    document.getElementById("openCartBtn").addEventListener("click", openCart);
    document.getElementById("closeCartBtn").addEventListener("click", closeCart);
    backdrop.addEventListener("click", closeCart);

    document.getElementById("checkoutBtn").addEventListener("click", () => {
      if (!cart.length) {
        showToast("Добавь хотя бы один бит в корзину");
        return;
      }
      cart = [];
      updateCartUI();
      closeCart();
      showToast("Заказ оформлен! Подключи приём оплат для реальных транзакций.");
    });

    // Форма кастомного бита
    document.getElementById("customForm").addEventListener("submit", (e) => {
      e.preventDefault();
      e.target.reset();
      showToast("Заявка отправлена! Не забудь привязать форму к Telegram или почте.");
    });

    renderBeats();
    updateCartUI();
  </script>
</body>
</html>
